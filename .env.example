# Email SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_ou_app_password

# Destinatários
EMAIL_DESTINATARIO=frotas@empresa.com.br

# Caminhos dos arquivos
# Caminho COMPLETO (absoluto) para o arquivo Excel com dados de CNH
# Exemplos:
#   - Pasta do projeto: cnhs.xlsx
#   - Caminho absoluto Windows: C:\dados\cnhs.xlsx
#   - Caminho absoluto rede: \\servidor\compartilhamento\cnhs.xlsx
ARQUIVO_CNH=cnhs.xlsx

# Pasta onde os relatórios serão salvos (com caminho completo)
# Se deixar em branco, salva na mesma pasta do projeto
# Exemplos:
#   - Em branco (pasta do projeto):
#   - Caminho absoluto Windows: C:\dados\relatorios
#   - Caminho absoluto rede: \\servidor\compartilhamento\relatorios
PASTA_RELATORIOS=

# Dias antes do vencimento para alertar
DIAS_ALERTA=7
